<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TuranApp.Views.СoursesPage"
             xmlns:fa="clr-namespace:FontAwesome"
             Title=""
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="50,*" Padding="0,15,0,8" RowSpacing="10">
        <Grid ColumnDefinitions="50,*" ColumnSpacing="10" Margin="20,0">
            <Border HeightRequest="50" WidthRequest="50" >
                <Label Text="{x:Static fa:FontAwesomeIcons.User}" FontFamily="FAR" FontSize="20" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" />
            </Border>
            <Border Grid.Column="1">
                <Grid >
                    <Label Text="{x:Static fa:FontAwesomeIcons.MagnifyingGlass}" FontFamily="FAS" FontSize="Title" VerticalTextAlignment="Center" HorizontalTextAlignment="End" Margin="15,0" />
                    <Entry Text="" Placeholder="Поиск" FontSize="18" VerticalOptions="Fill" Margin="10,-5" TranslationY="9"/>
                </Grid>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1" Padding="15"  >
            <StackLayout Spacing="20">
                

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>