<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TuranApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TuranApp.Views"
    xmlns:fa="clr-namespace:FontAwesome"
    Shell.FlyoutBehavior="Disabled"
    Title="TuranApp">

    <!--<ShellContent
        Title="PinCodePage"
        ContentTemplate="{DataTemplate local:PinCodePage}"
        Route="PinCodePage" />-->

    <TabBar x:Name="MyTabbar">
        <ShellContent Title="Главная" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage">
            <ShellContent.Icon>
                <FontImageSource Glyph="{x:Static fa:FontAwesomeIcons.ChartSimple}" FontFamily="FAS"
                                 Color="{AppThemeBinding Dark={StaticResource TextColorDark}, Light={StaticResource TextColorLight}}"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Инфор панэль" ContentTemplate="{DataTemplate local:InformationPanelPage}" Route="MainPage">
            <ShellContent.Icon>
                <FontImageSource Glyph="{x:Static fa:FontAwesomeIcons.PersonThroughWindow}" FontFamily="FAS"
                 Color="{AppThemeBinding Dark={StaticResource TextColorDark}, Light={StaticResource TextColorLight}}"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Курсы" ContentTemplate="{DataTemplate local:СoursesPage}" Route="MainPage">
            <ShellContent.Icon>
                <FontImageSource Glyph="{x:Static fa:FontAwesomeIcons.WindowRestore}" FontFamily="FAS"
                 Color="{AppThemeBinding Dark={StaticResource TextColorDark}, Light={StaticResource TextColorLight}}"/>
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Настройки" ContentTemplate="{DataTemplate local:SattingsPage}" Route="MainPage">
            <ShellContent.Icon>
                <FontImageSource Glyph="{x:Static fa:FontAwesomeIcons.Gear}" FontFamily="FAS"
                         Color="{AppThemeBinding Dark={StaticResource TextColorDark}, Light={StaticResource TextColorLight}}"/>
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
